<?xml version="1.0" encoding="utf-8"?>
<!--
    Release product only: the clean (no GApps) feed.

    This string lives in a per-product overlay dir, not in the shared
    overlay-lineage/, and that is the whole point. packages/apps/Updater builds its
    feed URL from exactly one resource (UpdatesNetworkDataSource.kt:25 reads
    R.string.updater_server_url), and the only channel concept in the app is the
    user preference that turns X.json into X_testing.json - there is no GApps
    channel in the enum (UserPreferencesRepository.kt:45, RELEASE | TESTING). With
    the URL in the shared overlay, all three products polled a30s.json, so a GApps
    install was offered the clean zip and installing it would quietly remove
    GmsCore/Phonesky. Whether a device may be updated with a GApps zip or a clean
    one is decided by what it is running, so it is decided by the product, here.

    Product wiring: lineage_a30s.mk adds $(LOCAL_PATH)/overlay-lineage-release.
    Each of the three variants defines updater_server_url in exactly one overlay
    directory, so there is no overlay-ordering question to get wrong.

    Feed is regenerated by hm_mod/make_ota_json.py -channel release and asserted
    against the built APK by hm_mod/gate_ota_channel.sh.
-->
<resources>
    <string name="updater_server_url" translatable="false">https://raw.githubusercontent.com/HyperRamzey/device_samsung_a30s/ota/a30s.json</string>
</resources>
