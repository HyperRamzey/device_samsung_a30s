# ET715 optical fingerprint mask-layer illumination relay.
#
# Started by init, not by a KernelSU module: this is what lets
# /data/adb/modules/fp_illum and /data/adb/modules/fp_udfps_type be deleted.
#
# It is a long-running `while true` loop, NOT oneshot, so init restarts it if it
# ever dies. init replaces the shell supervisor the KSU module used, which is
# strictly better: the restart accounting and service state show up in
# `dumpsys` and there is no second process to keep alive.
#
# Started on sys.boot_completed=1 rather than at post-fs-data, deliberately.
# At boot the vendor HALs are still registering, and wifi alone spends 24 s
# failing to reach a HIDL interface that no VINTF manifest declares before
# falling back to AIDL. The relay talks to dumpsys fingerprint/power, so
# starting it only once the system is up keeps that binder traffic out of the
# fragile window entirely - stronger than the relay's own BOOT_QUIET_SECONDS,
# because until this point the process does not exist at all.
#
# The script waits for the DECON illumination node to appear itself (see
# make_v9.py), so there is no second "wait" service here. That is intentional:
# a service whose command is `/system/bin/sh -c "..."` does not work, because
# init cannot exec system_file - there is no execute/entrypoint allow for it.
# The only way init can run this payload is via fp_illum_exec, which is what the
# shebang on the script needs.

service fp_illum /system/bin/fp_illum_relay.sh
    class core
    user root
    group root
    disabled
    restart_period 5

on property:sys.boot_completed=1
    start fp_illum

# Manual restart for diagnosis, no reboot needed:
#     adb shell su 0 sh -c 'stop fp_illum; start fp_illum'
# Log: /data/misc/fp_illum/relay.log