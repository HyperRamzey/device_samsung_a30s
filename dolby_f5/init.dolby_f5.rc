# Fold5 DAP stack. KernelSU owns mount/relabel capability for this optional root feature.
# Opt out: touch /data/dolby_f5/disabled + reboot.

service dolby_f5_mount /system/bin/sh /system/bin/dolby_f5.sh mount
    class late_start
    user root
    group root
    seclabel u:r:ksu:s0
    oneshot

on boot
    mkdir /data/dolby_f5 0755 root root

on property:sys.boot_completed=1
    start dolby_f5_mount
